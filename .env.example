# ─────────────────────────────────────────────────────────────
# ACTuCasa — Variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# En Vercel: Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://actucasa.com.ar

# Número de WhatsApp en formato internacional SIN el + (ej: 5491112345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Mensaje pre-cargado al abrir WhatsApp (opcional)
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola! Vi su web y quiero consultar sobre un proyecto

# Handle de Instagram SIN el @ (ej: ac.tucasa)
NEXT_PUBLIC_INSTAGRAM_HANDLE=ac.tucasa

# Token de verificación de Google Search Console (opcional)
# Se obtiene en: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
